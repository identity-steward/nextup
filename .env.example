# NextUp Network — Environment Variables
# Copy this file to .env and fill in your project's values.
# The .env file is gitignored and will NOT be committed to GitHub.

# Supabase (public client-side values — safe for browser exposure)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The following secrets are NOT stored in .env.
# They are configured as Edge Function secrets in the Supabase dashboard:
#   SUPABASE_SERVICE_ROLE_KEY  — server-only key, never exposed to browser
#   SUPABASE_DB_URL            — direct Postgres connection string
#   STRIPE_WEBHOOK_SECRET      — Stripe webhook signing secret
#   RESEND_API_KEY             — Resend email API key
#   FROM_EMAIL                 — sender email address for notifications
#   ADMIN_NOTIFY_EMAIL         — recipient for admin submission alerts
#   APP_URL                    — public site URL for email links
